{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/:path((?!formulario-reserva\\.html).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/formulario-reserva.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://www.quintocentenariohotel.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/formulario-reserva.html",
      "destination": "/salones.html"
    }
  ],
  "redirects": [
    {
      "source": "/reservas",
      "destination": "/reservas/",
      "permanent": true
    }
  ]
}
